<mxCell id="8" value="&lt;div style=&quot;box-sizing:border-box;width:100%;min-height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;color:#FFE0C2;font-family:&apos;IBM Plex Sans Variable&apos;,ui-sans-serif,system-ui,sans-serif;&quot;&gt;&lt;b style=&quot;font-size:19.2px;&quot;&gt;Beneš Template Emitter&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-weight:normal;font-size:19.2px;&quot;&gt;Emits deterministic, DRC-checked padded-Beneš geometry with predicted crossing-count gates and no A* calls.&lt;/span&gt;&lt;/div&gt;" style="align=center;verticalAlign=middle;verticalLabelPosition=middle;labelPosition=center;fontSize=19.2;fontStyle=1;spacingTop=4;spacingLeft=2;spacingRight=2;spacingBottom=2;overflow=fill;whiteSpace=wrap;html=1;fontFamily='IBM%20Plex%20Sans%20Variable'%2Cui-sans-serif%2Csystem-ui%2Csans-serif;shape=component;fillColor=#A35829;strokeColor=#7E451D;fontColor=#FFE0C2;likec4Description=Emits%20deterministic%2C%20DRC-checked%20padded-Bene%C5%A1%20geometry%20with%20predicted%20crossing-count%20gates%20and%20no%20A*%20calls.;likec4Links=%5B%7B%22url%22%3A%22..%2F..%2Fmrr_switch_optimizer%2Frouting%2Fbenes_template_layout.py%22%2C%22title%22%3A%22benes_template_layout.py%22%7D%5D;likec4ColorName=amber;likec4Size=md;likec4StrokeColor=%237E451D;" vertex="1" parent="3">
  
